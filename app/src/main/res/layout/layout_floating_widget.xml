<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/floating_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@android:color/transparent">

    <!-- Bong bóng biểu tượng chính -->
    <ImageView
        android:id="@+id/btn_floating_toggle"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_app_logo"
        android:background="@drawable/bg_floating_circle"
        android:padding="6dp"
        android:contentDescription="Tàng Long Auto Bubble" />

    <!-- Bảng điều khiển mở rộng khi chạm vào bong bóng -->
    <LinearLayout
        android:id="@+id/floating_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_floating_panel"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginEnd="8dp">

            <TextView
                android:id="@+id/tv_floating_character"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Long Phi • Tiêu Dao Lv.89"
                android:textColor="#FFD54F"
                android:textSize="11sp"
                android:textStyle="bold"
                android:maxWidth="160dp"
                android:ellipsize="end"
                android:singleLine="true" />

            <TextView
                android:id="@+id/tv_floating_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tàng Long Auto"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:maxWidth="160dp"
                android:ellipsize="end"
                android:singleLine="true" />
        </LinearLayout>

        <!-- Nút Bắt đầu / Tạm dừng Auto Click trên màn hình game -->
        <ImageView
            android:id="@+id/btn_floating_pause_resume"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:src="@android:drawable/ic_media_play"
            android:background="@drawable/bg_floating_btn"
            android:padding="5dp"
            android:contentDescription="Bắt đầu / Tạm dừng"
            android:layout_marginEnd="6dp" />

        <!-- Nút thêm điểm chạm mục tiêu (Target 1, 2, 3...) -->
        <ImageView
            android:id="@+id/btn_floating_add_target"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:src="@android:drawable/ic_input_add"
            android:background="@drawable/bg_floating_btn"
            android:padding="5dp"
            android:contentDescription="Thêm điểm chạm mục tiêu"
            android:layout_marginEnd="6dp" />

        <!-- Nút xóa tất cả điểm chạm -->
        <ImageView
            android:id="@+id/btn_floating_clear_targets"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:src="@android:drawable/ic_menu_delete"
            android:background="@drawable/bg_floating_btn"
            android:padding="5dp"
            android:contentDescription="Xóa điểm chạm"
            android:layout_marginEnd="6dp" />

        <!-- Nút cấp quyền Trợ Năng Accessibility nếu chưa bật -->
        <ImageView
            android:id="@+id/btn_floating_accessibility"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:src="@android:drawable/ic_dialog_alert"
            android:background="@drawable/bg_floating_btn"
            android:padding="5dp"
            android:contentDescription="Bật Trợ Năng"
            android:visibility="gone"
            android:layout_marginEnd="6dp" />

        <!-- Nút Mở bảng điều khiển chính ứng dụng -->
        <ImageView
            android:id="@+id/btn_floating_open_app"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:src="@android:drawable/ic_menu_preferences"
            android:background="@drawable/bg_floating_btn"
            android:padding="5dp"
            android:contentDescription="Mở ứng dụng" />
    </LinearLayout>

</LinearLayout>
